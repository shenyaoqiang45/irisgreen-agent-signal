{
  "manifest_version": 3,
  "name": "IrisGreen 打开即总结",
  "version": "1.7.2",
  "description": "打开网页就总结，划中英文单词或短句就翻译到 IrisGreen。",
  "permissions": ["webNavigation", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "打开即总结",
    "default_popup": "popup.html"
  }
}
